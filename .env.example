# Copy to .env and edit. .env is git-ignored; this file is not, so never put a
# real credential here.
#
#   cp .env.example .env
#
# Ways to use it:
#   docker compose --profile app --env-file .env up -d
#   docker run --env-file .env multitenancy:latest
#   set -a && . ./.env && set +a && ./mvnw spring-boot:run
#
# Every entry below maps to a property in application.properties: uppercase it,
# and turn each dot and dash into an underscore. So application.jwt.access-token-ttl
# becomes APPLICATION_JWT_ACCESS_TOKEN_TTL.
#
# The values shown are the defaults that ship in application.properties. They
# are fine for local development and are refused by the prod profile, because
# being in this repository makes them public.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------
# Under the prod, production or staging profile the application refuses to start
# unless these are set to something other than the development values.

# Signing key for the tokens the parent login issues. At least 32 bytes for
# HS256. Generate one with: openssl rand -base64 48
# Rotating it invalidates every token already issued.
APPLICATION_JWT_SECRET=change-this-development-only-secret-please-32b

APPLICATION_DATABASE_USER=root
APPLICATION_DATABASE_PASSWORD=root

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# {database} is substituted per database: the central one and one per tenant.
# Inside docker compose the host is "mysql" rather than "localhost".
APPLICATION_DATABASE_URL_TEMPLATE=jdbc:mysql://localhost:3306/{database}?createDatabaseIfNotExist=true&useUnicode=true&useJDBCCompliantTimezoneShift=true&useLegacyDatetimeCode=false&connectionTimeZone=UTC&useSSL=false&allowPublicKeyRetrieval=true

# Holds the tenant registry, accounts and memberships.
APPLICATION_DATABASE_CENTRAL_DATABASE=db_default

# Every tenant gets its own pool, so the ceiling is roughly
# tenants x maximum-pool-size connections against the server.
APPLICATION_DATABASE_MAXIMUM_POOL_SIZE=5
APPLICATION_DATABASE_MINIMUM_IDLE=0
APPLICATION_DATABASE_IDLE_TIMEOUT=1m

# ---------------------------------------------------------------------------
# Tenants
# ---------------------------------------------------------------------------
# Tenant "sehat" is served from database `sehat` at sehat.jvm.my.id.
APPLICATION_TENANT_BASE_DOMAIN=jvm.my.id

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------
APPLICATION_JWT_ISSUER=jvm.my.id
APPLICATION_JWT_ACCESS_TOKEN_TTL=30m
APPLICATION_JWT_REFRESH_TOKEN_TTL=14d

# ---------------------------------------------------------------------------
# Photo storage, any S3 compatible endpoint
# ---------------------------------------------------------------------------
# The bucket must already exist; the application does not create it. Locally the
# minio-init service in compose.yaml creates it.
APPLICATION_STORAGE_BUCKET=jvm-uploads
APPLICATION_STORAGE_REGION=us-east-1

# Empty selects AWS S3. Inside docker compose the host is "minio".
APPLICATION_STORAGE_ENDPOINT=http://localhost:9000

# Leave BOTH empty to use the AWS default credential chain, which is how an
# instance running with an IAM role is configured. Setting one without the other
# is refused.
APPLICATION_STORAGE_ACCESS_KEY=minioadmin
APPLICATION_STORAGE_SECRET_KEY=minioadmin

# MinIO needs path style access; AWS S3 does not.
APPLICATION_STORAGE_PATH_STYLE_ACCESS=true

# Set when objects are served from a CDN or a public bucket URL that differs
# from the API endpoint. Empty means build the URL from the endpoint.
# APPLICATION_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
APPLICATION_STORAGE_MAX_FILE_SIZE=5MB

# Where the email confirmation link points; the token is appended.
APPLICATION_VERIFY_BASE_URL=http://localhost:3000/verify-email

# Where the password reset link points; the token is appended.
APPLICATION_PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# ---------------------------------------------------------------------------
# Email (Brevo)
# ---------------------------------------------------------------------------
# Empty disables delivery: invitation links are then returned to the owner to
# pass on rather than emailed. The sender must be an address Brevo has verified
# for the account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@jvm.my.id
BREVO_SENDER_NAME=Multitenancy

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Held in memory, so each instance allows this rate.
APPLICATION_RATE_LIMIT_ENABLED=true
# AUTO uses Redis when it answers, MEMORY forces per-instance counting, REDIS
# refuses to start without it.
APPLICATION_RATE_LIMIT_BACKEND=AUTO
REDIS_HOST=localhost
REDIS_PORT=6379
APPLICATION_RATE_LIMIT_LOGIN_CAPACITY=10
APPLICATION_RATE_LIMIT_LOGIN_WINDOW=5m
APPLICATION_RATE_LIMIT_FORGOT_PASSWORD_CAPACITY=5
APPLICATION_RATE_LIMIT_FORGOT_PASSWORD_WINDOW=15m

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Set to prod, production or staging to enforce the credential rules above.
# SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Read by the Dockerfile entrypoint. Heap follows the container limit.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# S3StorageIntegrationTest skips when no S3 endpoint answers. Set this to true,
# as CI does, to turn "nothing is listening" into a failure instead, so a MinIO
# that never started cannot look like a pass.
# S3_INTEGRATION_REQUIRED=true
