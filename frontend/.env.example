# Copy to .env.local, which is git-ignored.
#
#   cp .env.example .env.local

# Where the Spring Boot API lives. Server side only: the browser never calls it
# directly, so the access token stays in an httpOnly cookie.
BACKEND_URL=http://localhost:8080

# Only used to preview the subdomain while typing an organization name. It is
# public by design, hence the NEXT_PUBLIC_ prefix; the backend remains the
# authority on what is actually created.
NEXT_PUBLIC_TENANT_BASE_DOMAIN=jvm.my.id
